{:paths ["src" "resources"]
 ;; Protocol logic is portable `.cljc` and depends on nothing that opens a
 ;; socket. Cryptographic primitives arrive through an injected provider, the
 ;; same seam `kotoba-lang/noise` uses -- so the JVM provider that makes this
 ;; usable today can be replaced by aiueos's native `.kotoba` objects
 ;; (`x25519.kotoba`, `sha256.kotoba`) without touching the handshake.
 ;;
 ;; The two dependencies are the certificate parser this workspace already has.
 ;; `tls.cert` must not grow a second one: a TLS client that parses X.509
 ;; differently from the CMS/timestamp path is two answers to "whose key is
 ;; this", and only one of them gets fixed. Both pins are the `main` tip as of
 ;; 2026-08-31 and `gh api repos/kotoba-lang/<repo>/compare/main...<sha>`
 ;; answers `identical` for each. The x509 pin moved that day for
 ;; `kotoba/x509/validity.kotoba`, which adds a guest and a test and does not
 ;; touch `src/`.
 :deps {
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/org-ietf-x509
        {:git/url "https://github.com/kotoba-lang/org-ietf-x509.git"
         :git/sha "8aeddb0624327e4beff91926c610b0ab5df704c8"}
        ;; Direct rather than only transitive: `tls.cert` reads
        ;; `subjectAltName`'s inner DER itself (see `leaf-dns-names`) and names
        ;; algorithm OIDs through `asn1.oid`. A transitive dependency that a
        ;; namespace requires by name is a dependency that disappears when the
        ;; intermediate drops it. x509 pins asn1 at 3704c75; this pin is four
        ;; commits ahead of that and a descendant of it, so tools.deps takes
        ;; this one.
        io.github.kotoba-lang/org-ietf-asn1
        {:git/url "https://github.com/kotoba-lang/org-ietf-asn1.git"
         :git/sha "e106c53357cf6649f8d3185e68aba0c00470685f"}
        ;; ECH (draft-ietf-tls-esni-25) encrypts ClientHelloInner with HPKE.
        ;; This is the one dependency in this repository that is a real
        ;; cryptographic implementation rather than a parser -- the provider
        ;; seam exists for primitives the handshake itself needs, and an
        ;; extension that names HPKE cipher suites by RFC 9180 identifier
        ;; wants the library that owns those identifiers, not a second copy
        ;; of the registry behind an injection point.
        io.github.kotoba-lang/org-ietf-hpke
        {:git/url "https://github.com/kotoba-lang/org-ietf-hpke.git"
         :git/sha "51486cce0fc2f94e4173a100e8f8cb411aeb1422"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      ;; The Kotoba compiler and KIR interpreter, so
                      ;; `kotoba/tls/peer.kotoba` is driven by the suite
                      ;; rather than described by it.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "2cb7d3f18205eadb3791441d3c3e09d9eb9b1a22"}
                      io.github.kotoba-lang/osaho
                      {:git/url "https://github.com/kotoba-lang/osaho.git"
                       :git/sha "56911149694ddaa382ce7d214ed62c69a2d917c5"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; The counting harness. Separate from :test because :test binds :main-opts
  ;; to the test-runner; with `-M:test:report` the later alias's :main-opts
  ;; wins and :test still supplies the classpath and the runner dependency.
  ;; It exits 3 -- not 0 and not 1 -- when it could not run its vectors at all:
  ;; a suite that could not measure has not found a bug, and reporting one is
  ;; its own kind of lie.
  :report {:extra-paths ["test"]
           :main-opts ["-m" "tls.report"]}

  ;; The ClojureScript path, and it covers `tls.ech-test` only.
  ;;
  ;; Everything else in this suite is `.clj` because the cryptographic
  ;; provider is injected and the one that exists is the JVM's. ECH's data
  ;; plane is different: its crypto is `org-ietf-hpke`, which is portable, so
  ;; the parser, the reconstruction and the confirmation derivation can all
  ;; run on both runtimes -- and the codec underneath them is byte arithmetic,
  ;; which is exactly where the two runtimes differ.
  ;;
  ;; Naming the one namespace rather than globbing is deliberate: a runner
  ;; that silently found nothing to run would report success.
  :cljs {:extra-paths ["test"]}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
