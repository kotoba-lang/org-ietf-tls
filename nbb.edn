;; nbb reads this file. It does NOT read deps.edn, and the
;; .cljs here are run as bare `nbb <file>`, so a coordinate declared only
;; there is invisible to them.
;;
;; :paths and every sha below are COPIED from deps.edn, not chosen here.
{:paths ["src" "resources" "."]
 :deps {
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; Declared HERE and not only in deps.edn: nbb reads nbb.edn and does NOT
        ;; read deps.edn or bb.edn, and the .cljs in this repo are run as
        ;; bare `nbb <file>`. A coordinate they cannot see is not a
        ;; declaration. sha and :paths are COPIED from deps.edn.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}}}
